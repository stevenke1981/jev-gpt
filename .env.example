# Copy to .env.local (ignored by git) and fill in. Variables already set in the system
# environment win over this file. jev-gpt also reads ~/.jev-gpt/.env.local.

# Jev decisions (typesafe/jev-1.14 via OpenRouter's Decisions API). With it set, JEV_MODE
# defaults to jev; without it the effort is picked by the built-in rules.
OPENROUTER_API_KEY=sk-or-...

# Optional: the main model through the OpenAI API (install --provider openai).
# OPENAI_API_KEY=sk-...

# Optional settings
# JEV_PROVIDER=chatgpt              # chatgpt | openai | openrouter
# JEV_GPT_MODEL=gpt-6.1-terra
# JEV_DEFAULT_EFFORT=medium
# JEV_MODE=jev                      # jev | heuristic | llm | off
